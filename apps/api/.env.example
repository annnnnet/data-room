DATABASE_URL=
DIRECT_URL=

# Local Postgres container used by the e2e suite (see docker-compose.yml at
# the repo root, `pnpm --filter @data-room/api test:e2e:db:up`). These are
# throwaway local-only credentials, not secrets.
DATABASE_URL_TEST=postgresql://data_room_test:data_room_test@localhost:5434/data_room_test
DIRECT_URL_TEST=postgresql://data_room_test:data_room_test@localhost:5434/data_room_test
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
STORAGE_BUCKET=data-room-files
WEB_ORIGIN=http://localhost:3000
PORT=4000
