{
  "name": "data-room",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e:db:up": "docker compose up -d --wait",
    "test:e2e:db:down": "docker compose down",
    "test:e2e": "pnpm --filter @data-room/api test:e2e:full"
  },
  "devDependencies": { "typescript": "^5.5.4" }
}
